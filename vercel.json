{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node vercel/copy-public.js",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "notion-sync.mjs"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" }
  ],
  "redirects": [
    { "source": "/magpy", "destination": "/magpy/", "permanent": false },
    { "source": "/privates", "destination": "/privates/", "permanent": false }
  ]
}
